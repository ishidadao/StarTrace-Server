# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.dev.vars
*.tsbuildinfo

# vercel
.vercel

/dist/
/.wrangler/
/outputs/
/work/
/.idea/
/.vscode/
